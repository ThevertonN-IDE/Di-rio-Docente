<file path="styles/interacoes.css">
/* ==============================================================
   PEÇA 1: Feedback Tátil para Botões e Ações (.touch-action)
   ============================================================== */
.touch-action {
  -webkit-tap-highlight-color: transparent;
  transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1), 
              box-shadow 0.15s ease, 
              background-color 0.15s ease, 
              opacity 0.15s ease;
  will-change: transform;
}

.touch-action:active {
  transform: scale(0.96);
}

.touch-card {
  -webkit-tap-highlight-color: transparent;
  transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), 
              box-shadow 0.18s ease, 
              border-color 0.18s ease;
}

.touch-card:active {
  transform: scale(0.985);
}

/* ==============================================================
   PEÇA 2: Fundo Desfocado Progressivo (.backdrop-smooth)
   ============================================================== */
.backdrop-smooth:not(.hidden) {
  animation: animarBackdrop 0.22s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes animarBackdrop {
  from {
    opacity: 0;
    backdrop-filter: blur(0px);
  }
  to {
    opacity: 1;
    backdrop-filter: blur(4px);
  }
}

/* ==============================================================
   PEÇA 3: Janela / Gaveta Deslizante (.sheet-smooth)
   ============================================================== */
.sheet-smooth {
  animation: deslizarSubida 0.26s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  will-change: transform, opacity;
}

@keyframes deslizarSubida {
  from {
    opacity: 0.6;
    transform: translateY(24px) scale(0.97);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* ==============================================================
   PADRONIZAÇÃO ERGONÓMICA: ALVOS DE TOQUE MÍNIMOS (44x44px)
   ============================================================== */
.touch-target-44 {
  min-width: 44px !important;
  min-height: 44px !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
}
