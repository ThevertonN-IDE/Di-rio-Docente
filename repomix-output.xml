    },
    basico: {
      nome: '➗ Básico & Álgebra',
      itens: [
        { rotulo: 'a/b', latex: '\\frac{a}{b}' },
        { rotulo: 'x²', latex: 'x^{2}' },
        { rotulo: 'xⁿ', latex: 'x^{n}' },
        { rotulo: 'x₁', latex: 'x_{1}' },
        { rotulo: '√x', latex: '\\sqrt{x}' },
        { rotulo: '³√x', latex: '\\sqrt[3]{x}' },
        { rotulo: 'ⁿ√x', latex: '\\sqrt[n]{x}' },
        { rotulo: '±', latex: '\\pm' },
        { rotulo: '×', latex: '\\times' },
        { rotulo: '÷', latex: '\\div' },
        { rotulo: '·', latex: '\\cdot' },
        { rotulo: '≠', latex: '\\neq' },
        { rotulo: '≤', latex: '\\le' },
        { rotulo: '≥', latex: '\\ge' },
        { rotulo: '≈', latex: '\\approx' }
      ]
    },
    constantes: {
      nome: 'π Constantes & Conjuntos',
      itens: [
        { rotulo: 'π', latex: '\\pi' },
        { rotulo: 'e', latex: 'e' },
        { rotulo: 'φ (phi)', latex: '\\phi' },
        { rotulo: '∞', latex: '\\infty' },
        { rotulo: 'ℝ', latex: '\\mathbb{R}' },
        { rotulo: 'ℕ', latex: '\\mathbb{N}' },
        { rotulo: 'ℤ', latex: '\\mathbb{Z}' },
        { rotulo: 'ℚ', latex: '\\mathbb{Q}' },
        { rotulo: 'ℂ', latex: '\\mathbb{C}' },
        { rotulo: '∅', latex: '\\emptyset' },
        { rotulo: '∈', latex: '\\in' },
        { rotulo: '∉', latex: '\\notin' },
        { rotulo: '⊂', latex: '\\subset' },
        { rotulo: '∪', latex: '\\cup' },
        { rotulo: '∩', latex: '\\cap' },
        { rotulo: '⇒', latex: '\\implies' },
